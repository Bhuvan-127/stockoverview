<mvc:View
    controllerName="stockoverview.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:t="sap.ui.table"
    xmlns:f="sap.f">

    <Page
        id="page"
        title="Stock Overview"
        enableScrolling="true">

        <content>

            <!-- Header Toolbar -->

            

            <!-- Filter Area -->

            <Panel
                class="sapUiResponsiveMargin"
                expandable="false">

                <content>

                    <VBox width="100%">

                        <HBox wrap="Wrap" class="sapUiSmallMarginBottom" alignItems="End">

                            <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                <Label
                                    text="Material"
                                    required="true" />

                                <Input
                                    width="220px"
                                    value="{stock>/filters/material}"
                                    valueState="{stock>/validation/materialState}"
                                    valueStateText="Material is required"
                                    showValueHelp="true"
                                    valueHelpRequest=".onValueHelpMaterial" />
                            </VBox>

                            <VBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                <Label text="Plant" />

                                <Input
                                    width="180px"
                                    value="{stock>/filters/plant}"
                                    showValueHelp="true"
                                    valueHelpRequest=".onValueHelpPlant" />
                            </VBox>

                            <VBox class="sapUiSmallMarginBottom">
                                <Label text="Storage Location" />

                                <Input
                                    width="180px"
                                    value="{stock>/filters/storageLocation}"
                                    showValueHelp="true"
                                    valueHelpRequest=".onValueHelpSLoc" />
                            </VBox>

                        </HBox>

                        <HBox wrap="Wrap" class="sapUiSmallMarginBottom" justifyContent="Start" width="100%">

                            <Button
                                text="Execute"
                                type="Emphasized"
                                class="sapUiSmallMarginEnd"
                                press=".onExecute" />

                            <Button
                                text="Clear"
                                type="Emphasized"
                                class="sapUiSmallMarginEnd"
                                press=".onClear"
                            />

                        </HBox>

                    </VBox>

                </content>

            </Panel>

            <!-- Tree Table -->

            <Panel
                headerText="Stock Hierarchy"
                class="sapUiResponsiveMargin">

                <t:TreeTable
                    rows="{
                        path:'stock>/stockHierarchy',
                        parameters:{
                            arrayNames:['nodes']
                        }
                    }"
                    visibleRowCount="8"
                    selectionMode="Single"
                    selectionBehavior="RowOnly"
                    rowSelectionChange=".onNodeSelect">

                    <t:columns>

                        <t:Column width="350px">
                            <Label text="Hierarchy Node" />

                            <t:template>
                                <HBox alignItems="Center">
                                    <core:Icon src="{stock>icon}" class="sapUiTinyMarginEnd" color="{stock>iconColor}" />
                                    <Text text="{stock>name}" />
                                </HBox>
                            </t:template>
                        </t:Column>

                        <t:Column hAlign="End" width="130px">
                            <Label text="Unrestricted-Use" />

                            <t:template>
                                <Text text="{stock>unrestricted}" />
                            </t:template>
                        </t:Column>

                        <t:Column hAlign="End" width="130px">
                            <Label text="Qual. Inspection" />

                            <t:template>
                                <Text text="{stock>inspection}" />
                            </t:template>
                        </t:Column>

                        <t:Column hAlign="End" width="130px">
                            <Label text="Blocked" />

                            <t:template>
                                <Text text="{stock>blocked}" />
                            </t:template>
                        </t:Column>

                        <t:Column hAlign="End" width="130px">
                            <Label text="Reserved" />

                            <t:template>
                                <Text text="{stock>reserved}" />
                            </t:template>
                        </t:Column>

                        <t:Column hAlign="End" width="130px">
                            <Label text="On-Order" />

                            <t:template>
                                <Text text="{stock>onOrder}" />
                            </t:template>
                        </t:Column>

                    </t:columns>

                </t:TreeTable>

            </Panel>

